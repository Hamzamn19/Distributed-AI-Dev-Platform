# Copy this file to .env and fill in real values. Never commit .env.
LLM_PROVIDER=mock                 # mock | ollama | cloud
OLLAMA_BASE_URL=http://127.0.0.1:11434
MASTER_MODEL=changeme             # model name used by the Master Agent
DATABASE_URL=sqlite:///./dev.db   # later: postgresql://user:password@host:5432/dbname
REDIS_URL=redis://127.0.0.1:6379/0
# CLOUD_API_KEY=                  # only if we use a cloud model in the demo
