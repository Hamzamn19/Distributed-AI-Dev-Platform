{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start DAP Platform",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal"
    },
    {
      "name": "Master Agent (FastAPI :8000)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/master/main.py",
      "cwd": "${workspaceFolder}/master",
      "python": "${workspaceFolder}/.venv/bin/python",
      "envFile": "${workspaceFolder}/master/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
