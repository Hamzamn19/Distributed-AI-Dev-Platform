# Docker
docker-compose.override.yml

# ---- Local AI stack (Gemma) -------------------------------------------------
# Everything under local-stack/ keeps the whole AI setup in one place, but the
# items below are multi-gigabyte binaries or per-machine state. They stay on
# this disk and must never be committed.
local-stack/models/
local-stack/llama.cpp/
local-stack/open-webui/app/
local-stack/open-webui/data/
*.gguf
*.ggml

# ---- Personal experiments: stay on this disk, never commit -------------------
# The whole local experiment stack and its notes, plus the personal assistant
# workspace (plans, ADR drafts). Ignored wholesale so no 'git add -A' can ever
# pick them up (that happened once, commit f5069bf, and had to be cleaned).
local-stack/
docs/local-stack/
docs/superpowers/
docs/adr/
