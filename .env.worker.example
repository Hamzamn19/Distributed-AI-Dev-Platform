# Settings for one extra worker on this PC, for local tests with two workers.
# Copy this file twice and change the three marked lines in the second copy:
#
#   copy .env.worker.example .env.worker1      (macOS/Linux: cp)
#   copy .env.worker.example .env.worker2
#   python -m dap.worker.main --env-file .env.worker1
#   python -m dap.worker.main --env-file .env.worker2
#
# A worker started with --env-file reads only that file, not .env.
# .env.worker1 and .env.worker2 are in .gitignore and must never be committed.

AGENT_TOKEN=change-me-team-secret
MASTER_URL=http://localhost:8000
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b
LLM_MOCK=1
LLM_TIMEOUT_SEC=600

# Change these three lines in .env.worker2 (for example agent-local-2, frontend, 9002).
AGENT_ID=agent-local-1
AGENT_ROLE_HINT=backend
# Port of this worker's A2A server (used from Sprint 3 phase 3 on)
WORKER_PORT=9001

AGENT_NAME=Local-Worker
AGENT_OWNER=YourName
AGENT_CAP_CODING=50
AGENT_CAP_REASONING=50
AGENT_CAP_CONTEXT=50
HEARTBEAT_INTERVAL_SEC=10
