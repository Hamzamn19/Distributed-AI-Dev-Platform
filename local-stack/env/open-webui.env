# Environment for open-webui.service
#
# The live copy of these values lives in the systemd unit
# (local-stack/systemd/open-webui.service). This file is the reference: it says
# what each variable does and why it is set. If you change one, change it in the
# unit too, then run:
#
#   cp local-stack/systemd/*.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user restart open-webui.service

# --- interface ---------------------------------------------------------------

# No login page: everyone who reaches the URL lands straight in the chat. All
# visitors share the built-in admin identity.
WEBUI_AUTH=false

# --- where all state lives ---------------------------------------------------

# Chat history, model settings, the project_files tool, and every access grant.
# Pointing this at the project folder keeps the interface inside the repo and
# keeps it alive across Open WebUI upgrades (a fresh install would otherwise
# write a brand-new database into site-packages).
DATA_DIR=/home/hamzah/Documents/Distributed-AI-Dev-Platform/local-stack/open-webui/data

# --- network -----------------------------------------------------------------

PORT=3000
HOST=127.0.0.1          # never bind to 0.0.0.0; Tailscale is the only way in

# --- web search / page loading ----------------------------------------------

# Stock aiohttp refuses every 3xx response unless this is true, so anything that
# redirects (news sites, shortened links, wiki -> mobile) silently returned an
# empty page. This is why search results used to look shallow.
AIOHTTP_CLIENT_ALLOW_REDIRECTS=true

# Playwright sets its own UA, but pages fetched through the plain fetcher need a
# plausible one or they are refused outright.
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36

# Tool-loop guard. The default is 256 rounds; each round appends the tool result
# to the context, so a model that keeps calling search_web grows the prompt by
# ~6k tokens per round and burns the GPU for minutes before failing. Ten rounds
# is plenty for a real turn and stops a runaway early.
CHAT_RESPONSE_MAX_TOOL_CALL_ITERATIONS=10
