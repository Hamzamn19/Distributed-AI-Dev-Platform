     def _extract_html(html):
         from unstructured.partition.html import partition_html
 
-        return '\n\n'.join(str(element) for element in partition_html(text=html))
+        text = '\n\n'.join(str(element) for element in partition_html(text=html))
+        if text.strip():
+            return text
+
+        # unstructured returns zero elements for some large or heavily-scripted
+        # documents (e.g. GitHub's shell page) even though the HTML is complete.
+        # Fall back to a plain tree walk so the fetch does not report "empty".
+        from bs4 import BeautifulSoup
+
+        soup = BeautifulSoup(html, 'html.parser')
+        for tag in soup(['script', 'style', 'noscript']):
+            tag.decompose()
+        lines = [line.strip() for line in soup.get_text('\n').splitlines()]
+        return '\n\n'.join(line for line in lines if line)
 
