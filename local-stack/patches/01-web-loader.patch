+# Realistic browser fingerprint: default Playwright headless ships a
+# "HeadlessChrome" UA and a webdriver flag that CDN bot filters reject outright.
+PLAYWRIGHT_USER_AGENT = (
+    'Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 '
+    '(KHTML, like Gecko) Chrome/153.0.0.0 Safari/537.36'
+)
+
+PLAYWRIGHT_INIT_SCRIPT = (
+    "Object.defineProperty(navigator,'webdriver',{get:()=>undefined});"
+    "Object.defineProperty(navigator,'languages',{get:()=>['en-US','en']});"
+    "window.chrome=window.chrome||{runtime:{}};"
+)
+
+
+def _new_playwright_context(browser):
+    """Context with a real-looking UA/viewport plus anti-automation fingerprints."""
+    return browser.new_context(
+        user_agent=os.getenv('WEB_LOADER_USER_AGENT') or PLAYWRIGHT_USER_AGENT,
+        viewport={'width': 1920, 'height': 1080},
+        locale='en-US',
+        timezone_id='UTC',
+        service_workers='block',
+        extra_http_headers={'Accept-Language': 'en-US,en;q=0.9'},
+    )
+
