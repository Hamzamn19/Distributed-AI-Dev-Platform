# Copy this file to ".env" and fill in your own values.
# ".env" is in .gitignore and must never be committed.

# --- Common (master and worker) ---
# Same value on all seven PCs. Sent in the X-Agent-Token header.
AGENT_TOKEN=change-me-team-secret
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:4b
# 1 = llm_client returns a fixed valid answer (tests, PCs without Ollama)
LLM_MOCK=0
# Seconds to wait for one model answer. Use 600 on worker PCs: writing code takes long.
LLM_TIMEOUT_SEC=120

# --- Master only ---
MASTER_HOST=0.0.0.0
MASTER_PORT=8000
DATABASE_URL=sqlite:///./data/dap.db
CORS_ORIGINS=*
HEARTBEAT_TIMEOUT_SEC=30
# A task not finished after this many seconds is marked failed
TASK_TIMEOUT_SEC=900
# How often the master asks a worker for its task status (A2A GetTask)
A2A_POLL_INTERVAL_SEC=3

# --- Worker only ---
# Two workers on one PC: see .env.worker.example
# Local test: http://localhost:8000
# Team work:  http://<master Tailscale IP>:8000
MASTER_URL=http://localhost:8000
AGENT_ID=agent-yourname
AGENT_NAME=YourName-PC
AGENT_OWNER=YourName
# One of: frontend, backend, database, testing, integration, code_review
AGENT_ROLE_HINT=backend
# Estimated in Sprint 1, measured in Sprint 2 (0-100)
AGENT_CAP_CODING=50
AGENT_CAP_REASONING=50
AGENT_CAP_CONTEXT=50
HEARTBEAT_INTERVAL_SEC=10
# The worker's A2A server; the master sends tasks to it
WORKER_HOST=0.0.0.0
WORKER_PORT=9000
# Address the master uses to reach this worker, e.g. http://100.x.y.z:9000.
# Empty: the worker uses its `tailscale ip -4` address, or 127.0.0.1 with a warning.
WORKER_PUBLIC_URL=
